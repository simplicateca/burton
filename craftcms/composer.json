{
    "config": {
        "type": "project",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2",
            "ext-bcmath": "8.2",
            "ext-intl": "8.2",
            "ext-bz2": "8.2",
            "ext-soap": "8.2",
            "ext-sodium": "8.2",
            "ext-zip": "8.2"
        },
        "allow-plugins": {
            "yiisoft/*": true,
            "craftcms/*": true,
            "treeware/plant": true,
            "php-http/discovery": true,
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "craftcms/cms": "^5.4.8",
        "craftcms/feed-me": "^6.5.0",
        "nystudio107/craft-seomatic": "^5.1.4",
        "nystudio107/craft-vite": "^5.0.1",
        "simplicateca/burton-protosite": "dev-develop",
        "vlucas/phpdotenv": "^5.6.1",
        "yiisoft/yii2-redis": "^2.0.18"
    },
    "require-dev": {
        "craftcms/generator": "^2.1.0",
        "yiisoft/yii2-shell": "^2.0.5"
    },
    "autoload": {
        "psr-4": {
            "modules\\local\\": "modules/local/src/"
        }
    }
}
